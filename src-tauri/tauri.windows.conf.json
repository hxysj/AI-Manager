{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["nsis"],
    "icon": ["../build/icon.png", "../build/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "../build/icon.ico",
        "uninstallerIcon": "../build/icon.ico",
        "installerHooks": "../build/installer.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
