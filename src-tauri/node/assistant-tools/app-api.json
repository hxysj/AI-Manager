    "description": "提交图片生成任务，返回任务 ID。仅代表提交成功，之后用 image-wait 或 image-detail 确认结果。沿用用户已选参数；无可用历史且账号不唯一时先确认账号。",
    "payload": {
      "accountId": "实际账号 ID",
      "generationMode": "web 或 codex",
      "mode": "generate",
      "prompt": "用户提示词",
      "model": "从模型列表读取",
      "size": "1024x1024",
      "quality": "auto",
      "n": 1,
      "outputFormat": "png",
      "background": "",
      "responseFormat": "url"
    }
  },
  {
    "module": "images",
    "channel": "tools:image-wait",
    "description": "等待指定图片任务结束，读取实际成功或失败状态。",
    "payload": { "ids": ["任务 ID"] }
  },
  {
    "module": "images",
    "channel": "tools:image-detail",
