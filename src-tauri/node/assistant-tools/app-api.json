[
  {
    "module": "quick-notes",
    "channel": "quick-notes:folders",
    "description": "读取已有便签分类和项目分组，返回实际 ID、kind、名称、别名和归档状态；可按 kind=category/group 筛选。自动归类前先读取并优先复用现有目录，只使用相同 kind 的 ID。",
    "payload": {}
  },
  {
    "module": "quick-notes",
    "channel": "quick-notes:list",
    "description": "查询速记便签、待办、分类分组和提醒。可按 search、groupId、categoryId、type、lifecycle、offset、limit 筛选。",
    "payload": {}
  },
  {
    "module": "quick-notes",
    "channel": "quick-notes:detail",
    "description": "读取便签原文、待办、提醒与修改历史。",
    "payload": { "id": "便签 ID" }
  },
  {
    "module": "quick-notes",
    "channel": "quick-notes:save",
    "description": "按用户要求静默记录或编辑便签。新建可只传 content；编辑必须回读当前 revision。type 为 note/todo/worklog，分类与分组 ID 从 list 读取。提醒必须有用户明确意图，使用未来毫秒时间，模糊时间不猜测。",
    "payload": {
      "content": "用户要求记录的原文",
      "type": "note",
      "groupId": "inbox",
      "categoryId": "uncategorized",
      "tasks": [],
      "reminders": []
    }
  },
  {
    "module": "quick-notes",
    "channel": "quick-notes:task-update",
    "description": "完成或重开指定便签中的待办，使用 detail 返回的真实任务 ID 和便签 revision。",
    "payload": {
      "id": "便签 ID",
      "revision": 1,
      "taskId": "任务 ID",
      "status": "completed"
    }
  },
  {
    "module": "quick-notes",
    "channel": "quick-notes:organize",
    "description": "整理、新建或编辑便签分类和项目分组。先读取 folders，复用相同名称或别名的目录；用户要求自动整理时可按内容新建缺少的目录。kind 为 group/category，aliases 为关键词数组。编辑时传原 id/name/kind；合并时额外传同 kind 的 mergeInto 目标 ID，将移动已有便签并移除源目录。archived 可归档目录，sortOrder 可调整排序。",
    "payload": { "kind": "group", "name": "项目名称", "aliases": [] }
  },
  {
    "module": "quick-notes",
    "channel": "quick-notes:archive",
    "description": "归档用户指定的便签并暂停提醒，使用实际 revision。",
    "payload": { "id": "便签 ID", "revision": 1 }
  },
  {
    "module": "quick-notes",
    "channel": "quick-notes:trash",
    "description": "将用户指定的便签移入回收站，并停止提醒，可以恢复。",
    "payload": { "id": "便签 ID", "revision": 1 }
  },
  {
    "module": "quick-notes",
    "channel": "quick-notes:restore",
    "description": "恢复归档或回收站中的便签，提醒保持暂停。",
    "payload": { "id": "便签 ID", "revision": 1 }
  },
  {
