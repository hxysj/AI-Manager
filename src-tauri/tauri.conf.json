{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Monkey Thief",
  "version": "2.0.6",
  "identifier": "com.monkeythief.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:renderer",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build:renderer",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Monkey Thief",
        "width": 944,
        "height": 608,
        "minWidth": 896,
        "minHeight": 576
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "useLocalToolsDir": true,
    "createUpdaterArtifacts": true,
    "icon": ["../build/icon.png", "../build/icon.ico"],
    "resources": {
      "../src/assets/ai-manager-logo.svg": "assets/ai-manager-logo.svg",
      "../build/icon.png": "assets/icon.png",
      "node/translation-service.mjs": "node/translation-service.mjs",
      "../node_modules/@xenova/transformers": "node_modules/@xenova/transformers",
      "../node_modules/onnxruntime-node": "node_modules/onnxruntime-node"
    },
    "windows": {
      "nsis": {
        "installerIcon": "../build/icon.ico",
        "uninstallerIcon": "../build/icon.ico",
        "installerHooks": "../build/installer.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENBNDdCRjQ0RUY1MzlCQ0UKUldUT20xUHZSTDlIeWdkaVdRY0Z6L0kvOUppYWxRWDdpb3BITzJHOG1XWVNwNkkwL241Y3pMZFgK",
      "endpoints": [
        "https://github.com/hxysj/AI-Manager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
