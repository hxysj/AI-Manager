{
  "name": "monkey-thief",
  "version": "2.0.31",
  "description": "Desktop manager for AI CLI skills, repos and runtime metadata",
  "type": "module",
  "scripts": {
    "dev": "node scripts/start-tauri-dev.mjs",
    "dev:bounded": "node scripts/start-tauri-dev.mjs --auto-prune",
    "clean:rust-target": "node scripts/clean-rust-target.mjs",
    "clean:rust-target:apply": "node scripts/clean-rust-target.mjs --apply --max-size-gb 30 --older-than-days 1",
    "predev:renderer": "node scripts/build-translation-agent.mjs && node scripts/build-assistant.mjs",
    "dev:renderer": "vite",
    "build": "tauri build",
    "prebuild:renderer": "node scripts/build-translation-agent.mjs && node scripts/build-assistant.mjs",
    "build:renderer": "vite build",
    "dist:win": "tauri build --bundles nsis --ci",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.103",
    "@langchain/openai": "^1.5.10",
    "@mastra/core": "1.83.0",
    "@mastra/libsql": "1.30.0",
    "@mastra/memory": "1.41.1",
    "@tauri-apps/api": "^2.11.0",
    "@xenova/transformers": "^2.17.2",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.0",
    "fuse.js": "^7.1.0",
    "langchain": "^1.5.10",
    "lucide-vue-next": "^1.0.0",
    "micromark": "4.0.3",
    "micromark-extension-gfm": "3.0.0",
    "monaco-editor": "^0.52.2",
    "onnxruntime-web": "1.30.0",
    "vue": "^3.5.13",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@vitejs/plugin-vue": "^5.2.4",
    "esbuild": "^0.25.12",
    "less": "^4.4.1",
    "vite": "^6.3.5"
  }
}
