{
  "name": "monkey-thief",
  "version": "1.0.14",
  "description": "Desktop manager for AI CLI skills, repos and runtime metadata",
  "config": {
    "electron_mirror": "https://npmmirror.com/mirrors/electron/"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "vite build",
    "build:update-config": "node scripts/generate-update-config.cjs",
    "dist:win": "npm run build:update-config && npm run build && electron-builder --win nsis --publish never",
    "start": "electron .",
    "preview": "vite preview",
    "test": "node --test tests/manager-service.test.cjs"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "chokidar": "^4.0.3",
    "echarts": "^6.1.0",
    "electron-updater": "^6.8.3",
    "element-plus": "^2.14.0",
    "fuse.js": "^7.1.0",
    "gray-matter": "^4.0.3",
    "lucide-vue-next": "^1.0.0",
    "monaco-editor": "^0.52.2",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^37.0.2",
    "electron-builder": "^26.8.1",
    "less": "^4.4.1",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.aimanager.desktop",
    "productName": "Monkey Thief",
    "artifactName": "Monkey-Thief-windows-setup.${ext}",
    "icon": "build/icon.ico",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "compression": "normal",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/assets/ai-manager-logo.svg",
        "to": "assets/ai-manager-logo.svg"
      },
      {
        "from": "build/icon.png",
        "to": "assets/icon.png"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Monkey Thief",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "hxysj",
        "repo": "AI-Manager",
        "private": true
      }
    ]
  }
}
