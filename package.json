{
  "name": "ai-manager",
  "version": "0.1.0",
  "description": "Desktop manager for AI CLI skills, repos and runtime metadata",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "vite build",
    "start": "electron .",
    "preview": "vite preview",
    "test": "node --test tests/manager-service.test.cjs"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "chokidar": "^4.0.3",
    "fuse.js": "^7.1.0",
    "gray-matter": "^4.0.3",
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^37.0.2",
    "less": "^4.4.1",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  }
}
