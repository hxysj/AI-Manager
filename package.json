    "fuse.js": "^7.1.0",
    "lucide-vue-next": "^1.0.0",
    "monaco-editor": "^0.52.2",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@vitejs/plugin-vue": "^5.2.4",
    "less": "^4.4.1",
    "vite": "^6.3.5"
  }
